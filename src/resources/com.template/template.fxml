<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
    <children>
        <Label layoutX="30.0" layoutY="30.0" text="Espécie:" />
        <TextField fx:id="txtEspecie" layoutX="90.0" layoutY="26.0" prefWidth="200.0" />

        <Label layoutX="30.0" layoutY="70.0" text="Idade:" />
        <TextField fx:id="txtIdade" layoutX="90.0" layoutY="66.0" prefWidth="100.0" />

        <CheckBox fx:id="chkCativeiro" layoutX="90.0" layoutY="110.0" mnemonicParsing="false" text="Ave de Cativeiro" />

        <Button fx:id="btnCadastrar" layoutX="320.0" layoutY="26.0" mnemonicParsing="false" onAction="#btnCadastrarAction" prefWidth="80.0" text="Cadastrar" />
        <Button fx:id="btnAtualizar" layoutX="320.0" layoutY="66.0" mnemonicParsing="false" onAction="#btnAtualizarAction" prefWidth="80.0" text="Atualizar" />
        <Button fx:id="btnExcluir" layoutX="410.0" layoutY="26.0" mnemonicParsing="false" onAction="#btnExcluirAction" prefWidth="80.0" text="Excluir" />
        <Button fx:id="btnLimpar" layoutX="410.0" layoutY="66.0" mnemonicParsing="false" onAction="#btnLimparAction" prefWidth="80.0" text="Limpar" />

        <TableView fx:id="tblPassarinho" layoutX="30.0" layoutY="160.0" onMouseClicked="#selecionarPassarinho" prefHeight="250.0" prefWidth="540.0">
            <columns>
                <TableColumn fx:id="colEspecie" prefWidth="240.0" text="Espécie" />
                <TableColumn fx:id="colIdade" prefWidth="100.0" text="Idade" />
                <TableColumn fx:id="colCativeiro" prefWidth="198.0" text="É Cativeiro?" />
            </columns>
        </TableView>
    </children>
</AnchorPane>